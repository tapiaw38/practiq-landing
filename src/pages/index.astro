  .button{display:inline-flex;gap:12px;align-items:center;justify-content:center;background:linear-gradient(135deg,#7455f5,var(--purple-dark));border-radius:10px;padding:16px 21px;color:#fff;text-decoration:none;font-weight:700;font-size:15px;box-shadow:0 10px 22px rgba(91,65,212,.23);transition:transform .2s,box-shadow .2s,filter .2s}.button:hover{filter:brightness(1.04);transform:translateY(-2px);box-shadow:0 14px 28px rgba(91,65,212,.29)}.button:focus-visible,.nav-links a:focus-visible,.text-link:focus-visible{outline:3px solid rgba(101,69,237,.35);outline-offset:3px}.button span{font-size:20px;line-height:14px}.button-small{padding:11px 17px;font-size:14px}.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:64px;align-items:center;padding-top:84px}.hero-copy{min-width:0}.eyebrow{font:500 11px 'DM Mono',monospace;color:#6956b2;letter-spacing:1.2px;margin:0 0 20px;text-transform:uppercase}.eyebrow:before{content:'✦';font-size:9px;margin-right:8px;color:#8b73fb}.hero h1,h2{font-size:59px;line-height:1.04;letter-spacing:-3.4px;margin:0;font-weight:700}.hero h1 em,h2 em{font-family:Fraunces,serif;font-weight:600;color:#6542ec}.lead{font-size:18px;line-height:1.58;color:var(--muted);max-width:540px;margin:27px 0}.hero-actions{display:flex;gap:25px;align-items:center}.text-link{display:flex;gap:9px;align-items:center;transition:color .2s,transform .2s}.text-link:hover{color:var(--purple-dark);transform:translateX(2px)}.microcopy{margin-top:18px;font-size:12px;color:#8992a5}
