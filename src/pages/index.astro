place-items:center;font-size:9px;font-weight:700}.a1{background:#ffddd1;color:#d45532}.a2{background:#d7e7ff;color:#3970b6}.a3{background:#e7d9ff;color:#7c49c9}.trusted{display:flex;align-items:center;gap:20px;color:#827da1;font:10px 'DM Mono',monospace;letter-spacing:.7px;margin-top:93px}.trusted-rule{height:1px;background:linear-gradient(90deg,#d9d4ee,transparent);flex:1}
  .problem{padding-top:140px;padding-bottom:139px}.problem-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:80px;align-items:end}.problem h2,.how h2,.pricing h2,.cta h2{font-size:43px;letter-spacing:-2.6px}.problem-grid p,.pricing-copy>p:not(.eyebrow){font-size:17px;color:var(--muted);line-height:1.65;margin:0}.how{position:relative;overflow:hidden;padding:110px 0 118px;background:radial-gradient(circle at 88% 5%,#29385d 0,transparent 32%),#18223d;color:#fff}.how:before{content:'';position:absolute;width:460px;height:460px;border:1px solid rgba(188,173,255,.16);border-radius:50%;right:-140px;bottom:-280px}.how .wrap{position:relative}.how .eyebrow,.cta .eyebrow{color:#c9c0ff}.how h2{color:#fff}.how h2 em,.cta h2 em{color:#c6baff}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:57px}.feature{border-top:1px solid #43506d;padding:17px 17px 10px 0;position:relative;transition:transform .25s,border-color .25s}.feature:hover{transform:translateY(-5px);border-color:#aa9aff}.feature>span{color:#9b91c3;font:11px 'DM Mono',monospace}.feature-icon{font-size:29px;color:#b6a8ff;margin:36px 0 18px;height:33px}.feature h3{font-size:19px;margin:0 0 10px}.feature p{color:#b8c0d1;font-size:15px;line-height:1.55;margin:0;max-width:275px}
  .pricing{padding-top:130px;padding-bottom:130px}.pricing-copy{max-width:620px;margin-bottom:46px}.pricing-copy>p:not(.eyebrow){margin-top:23px}.price-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;align-items:stretch}.price-card{height:100%;display:flex;flex-direction:column;background:linear-gradient(145deg,#fbfaff,#efebff);border:1px solid #e2ddff;border-radius:18px;padding:29px 27px 27px;box-shadow:0 15px 36px rgba(83,63,171,.09);transition:transform .25s,box-shadow .25s,border-color .25s}.price-card:hover{border-color:#bcaeff;transform:translateY(-6px);box-shadow:var(--shadow)}.price-card--free{background:#fff;border-color:#cfc6f4}.price-card--free .price span{margin-left:10px}.price-card--free .button{background:#fff;color:var(--purple-dark);border:1px solid #cfc6f4;box-shadow:none}.price-card--free .button:hover{background:var(--lilac);filter:none}.price-label{font:500 10px 'DM Mono',monospace;color:#6956b2;letter-spacing:1px}.price-card h3{font-size:21px;margin:13px 0 20px}.price{display:flex;align-items:center;color:var(--purple)}.price strong{font-size:42px;letter-spacing:-2.3px;line-height:1}.price span{font:11px/1.4 'DM Mono',monospace;margin-left:10px;color:#65708b}.price-note{font-size:12px;color:#778096;margin:12px 0 22px}.price-card ul{border-top:1px solid #ded9f5;padding:19px 0 10px;margin:0 0 12px;list-style:none;flex:1}.price-card li{font-size:13px;line-height:1.35;margin:11px 0;color:#33405a}.price-card li:before{content:'✓';color:#6746ee;font-weight:700;margin-right:9px}.full{width:100%;font-size:13px;padding:14px 12px}.plans-loading{grid-column:1/-1;margin:0;padding:30px;color:#63708a;background:#f4f2ff;border:1px dashed #cfc6f4;border-radius:17px;text-align:center}
  .cta{background:radial-gradient(circle at 80% 0,#9d85ff 0,transparent 35%),linear-gradient(115deg,#5639d3,#7d59ec);color:#fff;padding:78px 0}.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:30px}.cta h2{color:#fff}.button-light{background:#fff;color:#5332dc;white-space:nowrap;box-shadow:0 9px 22px rgba(36,19,112,.2)}.button-light:hover{background:#f7f5ff}.footer{height:105px;display:flex;align-items:center;gap:24px;color:#8490a4;font-size:13px}.footer p{margin-right:auto}.footer span{font-size:12px}
  @media(max-width:930px){.hero-grid{gap:38px}.price-card{padding:29px}.hero h1{font-size:52px}}@media(max-width:800px){.nav-links{display:none}.hero{min-height:0}.hero:after{right:-330px;top:210px}.hero-grid,.problem-grid{grid-template-columns:1fr;gap:42px}.hero-grid{padding-top:56px}.hero h1,h2{font-size:43px;letter-spacing:-2.5px}.product-card{transform:none;margin:0 8px}.product-card:hover{transform:translateY(-4px)}.trusted{margin-top:65px;padding-bottom:40px}.trusted span:last-child{display:none}.problem{padding-top:80px;padding-bottom:80px}.problem h2,.how h2,.pricing h2,.cta h2{font-size:35px}.how{padding:78px 0}.feature-grid{grid-template-columns:1fr;gap:43px;margin-top:42px}.pricing{padding-top:80px;padding-bottom:80px}.cta{padding:65px 0}.cta-inner{align-items:flex-start;flex-direction:column}.footer{height:auto;padding-top:30px;padding-bottom:30px;flex-wrap:wrap}.footer p{width:100%;order:3}.footer span{margin-left:auto}}@media(max-width:560px){.price-grid{grid-template-columns:1fr}.nav{height:76px}.hero-grid{padding-top:42px}.lead{font-size:16px}.trusted{gap:12px;font-size:9px}.price-card{padding:27px 21px}}@media(max-width:430px){.hero-actions{align-items:flex-start;flex-direction:column;gap:18px}.hero h1{font-size:38px}.dashboard{padding:18px 12px}.mini-sidebar{display:none}.price strong{font-size:39px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button,.product-card,.feature,.price-card,.text-link{transition:none}.button:hover,.product-card:hover,.feature:hover,.price-card:hover,.text-link:hover{transform:none}}
</style>
